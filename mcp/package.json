{
  "name": "ngyn-soc-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the NGYN Social Operation Center. Each staff member connects their own ChatGPT, which acts for them with their permissions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "agent-access": "tsx --env-file-if-exists=.env src/admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
