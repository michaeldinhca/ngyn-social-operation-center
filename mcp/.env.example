# Copy to .env (git ignores it).

# Demo sign-in passcode, at least 12 characters. Stands in for the municipality's single sign-on.
# Share it only with the people testing; never put it in chat or the repo.
DEMO_SIGNIN_PASSCODE=

# Optional
# MCP_PORT=8800
# MCP_HOST=127.0.0.1
# The public HTTPS address when a tunnel or host is approved (ChatGPT needs one), for example
# https://soc-mcp.example.ngynsolutions.com. Tokens and metadata use this as the issuer.
# MCP_PUBLIC_URL=
# Set to 1 behind a tunnel or reverse proxy.
# TRUST_PROXY=1
