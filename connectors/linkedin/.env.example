# Copy to .env (git ignores it). Use a TEST member or a TEST company page, never a municipal one.

# From your LinkedIn app (developer portal, Auth tab). Add the redirect URL below to the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8790/callback
# Company pages need the Community Management API product and these extra scopes:
# LINKEDIN_SCOPES=openid profile w_member_social w_organization_social r_organization_social

# Filled in by npm run auth. Never paste a token into chat.
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:{id} (set automatically) or urn:li:organization:{id} for a company page
LINKEDIN_AUTHOR_URN=

# Optional
# LINKEDIN_VERSION=202610
# CONNECTOR_PORT=8788
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
