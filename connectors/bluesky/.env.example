# Copy to .env (git ignores it). Use a TEST account, never a municipal one.
# Create an app password at bsky.app: Settings > Privacy and security > App passwords.
# Never put the account's real password here.
BLUESKY_IDENTIFIER=your-test-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional
# BLUESKY_SERVICE=https://bsky.social
# CONNECTOR_PORT=8787
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
