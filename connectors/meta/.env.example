# Copy to .env (git ignores it). Use a TEST Page and a TEST Instagram account, never a municipal one.

# From the Meta app dashboard: App settings > Basic. Add the redirect URL below to
# Facebook Login > Settings > Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8791/callback
# META_GRAPH_VERSION=v26.0
# Facebook Login for Business: set its configuration ID instead of a scope list.
# META_LOGIN_CONFIG_ID=
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_read_user_content,pages_manage_engagement,instagram_basic,instagram_content_publish,instagram_manage_comments,business_management

# Filled in by npm run auth. Set META_PAGE_ID first if the login manages several Pages.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# Optional
# CONNECTOR_PORT=8789
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
